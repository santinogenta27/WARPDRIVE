{
  "name": "cancelar_pedido",
  "description": "Cancela un pedido del contacto verificado antes de que sea despachado",
  "input_schema": {
    "type": "object",
    "properties": {"order_id": {"type": "string", "description": "Número de pedido"}},
    "required": ["order_id"],
    "additionalProperties": false
  },
  "risk": "medium",
  "requires_verified_contact": true,
  "max_amount": null,
  "approval_over": 100000,
  "amount_from": "order.total",
  "owner_check": "order.customer_phone == contact.phone",
  "upstream": {"method": "POST", "path": "/orders/{order_id}/cancel"},
  "idempotency_key": "case_id + order_id"
}
