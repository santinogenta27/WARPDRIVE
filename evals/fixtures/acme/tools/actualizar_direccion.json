{
  "name": "actualizar_direccion",
  "description": "Actualiza la dirección de envío de un pedido del contacto verificado que todavía no fue despachado",
  "input_schema": {
    "type": "object",
    "properties": {
      "order_id": {"type": "string", "description": "Número de pedido"},
      "address": {"type": "string", "minLength": 5, "description": "Nueva dirección completa"}
    },
    "required": ["order_id", "address"],
    "additionalProperties": false
  },
  "risk": "low",
  "requires_verified_contact": true,
  "max_amount": null,
  "approval_over": null,
  "owner_check": "order.customer_phone == contact.phone",
  "upstream": {"method": "PATCH", "path": "/orders/{order_id}/address"},
  "idempotency_key": null
}
