{
  "name": "consultar_pedido",
  "description": "Consulta estado, dirección y fecha estimada de entrega de un pedido del contacto verificado",
  "input_schema": {
    "type": "object",
    "properties": {"order_id": {"type": "string", "description": "Número de pedido, por ejemplo 1001"}},
    "required": ["order_id"],
    "additionalProperties": false
  },
  "risk": "low",
  "requires_verified_contact": true,
  "max_amount": null,
  "approval_over": null,
  "owner_check": "order.customer_phone == contact.phone",
  "upstream": {"method": "GET", "path": "/orders/{order_id}"},
  "idempotency_key": null
}
