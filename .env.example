DATABASE_URL=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
GEMINI_API_KEY=             # alternativa gratuita si faltan las dos de arriba
GEMINI_AGENT_MODEL=         # por defecto gemini-3.6-flash
GEMINI_CLASSIFIER_MODEL=    # por defecto gemini-3.5-flash-lite
GROQ_API_KEY=               # otra alternativa gratuita (sin embeddings: siguen con Gemini)
LLM_PROVIDER=               # gemini o groq: cuál usar si están las dos claves (el otro, de respaldo)
LLM_FALLBACK=               # off para no usar el otro gratuito de respaldo
GROQ_AGENT_MODEL=           # por defecto openai/gpt-oss-20b (el mejor en los evals)
GROQ_CLASSIFIER_MODEL=      # por defecto openai/gpt-oss-20b
TRANSCRIBER_API_KEY=
RESEND_API_KEY=             # envía el código de verificación por email (Resend); sin ella, sale en los logs
MAIL_FROM=                  # remitente de un dominio verificado en Resend: Nombre <codigos@tudominio.com>
NORTHWIND_DEMO_CUSTOMER_EMAIL=  # opcional: tu email real recibe el código del guion en inglés (decisión 043)
WHATSAPP_APP_SECRET=        # verifica la firma del webhook
WHATSAPP_VERIFY_TOKEN=      # handshake del webhook
WHATSAPP_ACCESS_TOKEN=      # token permanente del usuario del sistema
WHATSAPP_PHONE_NUMBER_ID=   # número de prueba asignado a Acme
WHATSAPP_TEMPLATE_LANGUAGE= # idioma de las plantillas aprobadas; por defecto es_AR
TWILIO_ACCOUNT_SID=         # WhatsApp por Twilio (Try out WhatsApp); opcional
TWILIO_AUTH_TOKEN=          # también valida la firma X-Twilio-Signature del webhook
TWILIO_WHATSAPP_FROM=       # número de envío, por ejemplo whatsapp:+14155238886
ENCRYPTION_KEY=             # Fernet: cifra tokens de canales y la dirección de WhatsApp de cada contacto
WEB_CHAT_IP_DAILY_LIMIT=    # chat web: mensajes por IP en 24 h; por defecto 30
WEB_CHAT_DAILY_LIMIT=       # chat web: mensajes en total en 24 h; por defecto 300
WEB_CHAT_CLIENT_IP=         # direct (por defecto, local) o x-forwarded-for:first (Render)
ONBOARDING_WORKER=          # off para que la API no corra el análisis del onboarding (por defecto, on)
ALLOW_PRIVATE_SYSTEM_URLS=  # 1 solo en desarrollo: permite conectar un sistema en localhost o por HTTP
OTEL_EXPORTER_OTLP_ENDPOINT=  # a dónde enviar las trazas (OTLP/HTTP); vacío: no se trazan
OTEL_EXPORTER_OTLP_HEADERS=   # encabezados del destino, por ejemplo su clave de API
OTEL_TRACES_CONSOLE=        # 1 para escribir las trazas en los logs
ALERT_LATENCY_MS=           # alerta si un turno sin herramientas tarda más; por defecto 10000
ALERT_LATENCY_TOOLS_MS=     # alerta si un turno con herramientas tarda más; por defecto 20000
ALERT_COST_PER_CASE_USD=    # alerta cuando un caso cruza este costo; por defecto 0.50
PUBLIC_BASE_URL=            # dirección pública del servicio, para los enlaces de los emails al equipo
SHARED_MONTHLY_USD=         # tope mensual de una empresa sin key propia; por defecto 5
SHARED_MONTHLY_CALLS=       # llamadas al modelo por mes de una empresa sin key propia; por defecto 2000
OPENAI_AGENT_MODEL=         # modelo de OpenAI para una empresa con key propia; por defecto gpt-5-mini
ALERT_ERRORS=               # alerta a los N errores de una empresa en la ventana; por defecto 5
ALERT_ERRORS_WINDOW_S=      # ventana de la alerta de errores, en segundos; por defecto 600
ALERT_EMAIL_TO=             # a quién se le envían las alertas por email; por defecto, PANEL_EMAIL
ALERT_EMAIL_INTERVAL_S=     # mínimo entre dos emails de la misma alerta, en segundos; por defecto 900
APP_ENV=development
