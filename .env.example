DATABASE_URL=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
GEMINI_API_KEY=             # alternativa gratuita si faltan las dos de arriba
GEMINI_AGENT_MODEL=         # por defecto gemini-3.6-flash
GEMINI_CLASSIFIER_MODEL=    # por defecto gemini-3.5-flash-lite
GROQ_API_KEY=               # otra alternativa gratuita (sin embeddings: siguen con Gemini)
LLM_PROVIDER=               # gemini o groq: cuál usar si están las dos claves (el otro, de respaldo)
LLM_FALLBACK=               # off para no usar el otro gratuito de respaldo
GROQ_AGENT_MODEL=           # por defecto openai/gpt-oss-20b (el mejor en los evals)
GROQ_CLASSIFIER_MODEL=      # por defecto openai/gpt-oss-20b
TRANSCRIBER_API_KEY=
MAILER_API_KEY=
WHATSAPP_APP_SECRET=        # verifica la firma del webhook
WHATSAPP_VERIFY_TOKEN=      # handshake del webhook
WHATSAPP_ACCESS_TOKEN=      # token permanente del usuario del sistema
WHATSAPP_PHONE_NUMBER_ID=   # número de prueba asignado a Acme
WHATSAPP_TEMPLATE_LANGUAGE= # idioma de las plantillas aprobadas; por defecto es_AR
TWILIO_ACCOUNT_SID=         # WhatsApp por Twilio (Try out WhatsApp); opcional
TWILIO_AUTH_TOKEN=          # también valida la firma X-Twilio-Signature del webhook
TWILIO_WHATSAPP_FROM=       # número de envío, por ejemplo whatsapp:+14155238886
ENCRYPTION_KEY=             # Fernet: cifra tokens de canales y la dirección de WhatsApp de cada contacto
WEB_CHAT_IP_DAILY_LIMIT=    # chat web: mensajes por IP en 24 h; por defecto 30
WEB_CHAT_DAILY_LIMIT=       # chat web: mensajes en total en 24 h; por defecto 300
WEB_CHAT_CLIENT_IP=         # direct (por defecto, local) o x-forwarded-for:first (Render)
ONBOARDING_WORKER=          # off para que la API no corra el análisis del onboarding (por defecto, on)
ALLOW_PRIVATE_SYSTEM_URLS=  # 1 solo en desarrollo: permite conectar un sistema en localhost o por HTTP
APP_ENV=development
