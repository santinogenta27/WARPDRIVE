{
  "openapi": "3.1.0",
  "info": {
    "title": "Northwind Outfitters — Orders API (simulated)",
    "version": "1.0.0",
    "description": "Fictional API of the Northwind Outfitters demo store. Synthetic data for development, CI and demos."
  },
  "paths": {
    "/customers": {
      "get": {
        "operationId": "buscarClientes",
        "summary": "Customers with a registered email (case-insensitive); empty list if none",
        "parameters": [
          {"name": "email", "in": "query", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {
            "description": "Customers found",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CustomerList"}}}
          }
        }
      }
    },
    "/products": {
      "get": {
        "operationId": "buscarProductos",
        "summary": "Searches the catalog: each product with its real price and its variants (size and color) with the units in stock right now. Use it for any question about products, prices, sizes, colors or stock",
        "parameters": [
          {"name": "query", "in": "query", "required": false, "description": "Words of what the customer is looking for (\"rain jacket\", \"merino sweater\"); empty for the whole catalog", "schema": {"type": "string"}},
          {"name": "size", "in": "query", "required": false, "description": "Only the variants of this size (\"M\", \"32\")", "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {
            "description": "Products found (an empty list if none)",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProductList"}}}
          }
        }
      }
    },
    "/checkouts": {
      "post": {
        "operationId": "armarCarrito",
        "summary": "Builds a cart with the variants the customer chose (SKUs from buscar_productos) and returns the store's checkout link, where the customer completes the purchase. It doesn't take any payment",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CheckoutRequest"}}}
        },
        "responses": {
          "201": {
            "description": "Cart ready, with its checkout link",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Checkout"}}}
          },
          "409": {"$ref": "#/components/responses/Conflict"}
        }
      }
    },
    "/orders": {
      "get": {
        "operationId": "listarPedidos",
        "summary": "A customer's orders by phone number",
        "parameters": [
          {"name": "customer_phone", "in": "query", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {
            "description": "The customer's orders",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OrderList"}}}
          }
        }
      }
    },
    "/orders/{order_id}": {
      "get": {
        "operationId": "consultarPedido",
        "summary": "Looks up the status, items, carrier, tracking and estimated delivery (including any delay) of an order of the verified customer",
        "parameters": [{"$ref": "#/components/parameters/OrderId"}],
        "responses": {
          "200": {
            "description": "Order",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Order"}}}
          },
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      }
    },
    "/orders/{order_id}/address": {
      "patch": {
        "operationId": "actualizarDireccion",
        "summary": "Updates the shipping address of an order of the verified customer that hasn't shipped yet",
        "parameters": [{"$ref": "#/components/parameters/OrderId"}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AddressChange"}}}
        },
        "responses": {
          "200": {
            "description": "Updated order",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Order"}}}
          },
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"}
        }
      }
    },
    "/orders/{order_id}/cancel": {
      "post": {
        "operationId": "cancelarPedido",
        "summary": "Cancels an order of the verified customer before it ships",
        "parameters": [
          {"$ref": "#/components/parameters/OrderId"},
          {"$ref": "#/components/parameters/IdempotencyKey"}
        ],
        "responses": {
          "200": {
            "description": "Cancelled order",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Order"}}}
          },
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"}
        }
      }
    },
    "/orders/{order_id}/refunds": {
      "post": {
        "operationId": "iniciarReembolso",
        "summary": "Starts a refund to the original payment method for a delivered order of the verified customer",
        "parameters": [
          {"$ref": "#/components/parameters/OrderId"},
          {"$ref": "#/components/parameters/IdempotencyKey"}
        ],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RefundRequest"}}}
        },
        "responses": {
          "201": {
            "description": "Refund started (or the existing one for the same idempotency key)",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Refund"}}}
          },
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"}
        }
      }
    },
    "/orders/{order_id}/exchanges": {
      "post": {
        "operationId": "iniciarCambio",
        "summary": "Starts a free exchange of an item of a delivered order of the verified customer for another size, color or product; a prepaid return label is emailed and the new item ships when the carrier scans the return. Each item can be exchanged once",
        "parameters": [
          {"$ref": "#/components/parameters/OrderId"},
          {"$ref": "#/components/parameters/IdempotencyKey"}
        ],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExchangeRequest"}}}
        },
        "responses": {
          "201": {
            "description": "Exchange started (or the existing one for the same idempotency key)",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Exchange"}}}
          },
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"}
        }
      }
    },
    "/orders/{order_id}/coupons": {
      "post": {
        "operationId": "ofrecerCupon",
        "summary": "Gives the verified customer a courtesy coupon for a percentage off the next order, for a problem with this order. One courtesy (coupon or free express shipping) per order",
        "parameters": [
          {"$ref": "#/components/parameters/OrderId"},
          {"$ref": "#/components/parameters/IdempotencyKey"}
        ],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CouponRequest"}}}
        },
        "responses": {
          "201": {
            "description": "Coupon created (or the existing one for the same idempotency key)",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Courtesy"}}}
          },
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"}
        }
      }
    },
    "/orders/{order_id}/express-shipping": {
      "post": {
        "operationId": "ofrecerEnvioExpress",
        "summary": "Gives the verified customer free express shipping on the next order, for a problem with this order. One courtesy (coupon or free express shipping) per order",
        "parameters": [
          {"$ref": "#/components/parameters/OrderId"},
          {"$ref": "#/components/parameters/IdempotencyKey"}
        ],
        "responses": {
          "201": {
            "description": "Free express shipping granted (or the existing one for the same idempotency key)",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Courtesy"}}}
          },
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"}
        }
      }
    }
  },
  "components": {
    "parameters": {
      "OrderId": {"name": "order_id", "in": "path", "required": true, "description": "Order number, for example NW-4521", "schema": {"type": "string"}},
      "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": false, "schema": {"type": "string"}}
    },
    "responses": {
      "NotFound": {
        "description": "Order not found",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
      },
      "Conflict": {
        "description": "The operation doesn't apply to the order's current status",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {"code": {"type": "string"}, "message": {"type": "string"}},
        "required": ["code", "message"],
        "additionalProperties": false
      },
      "Variant": {
        "type": "object",
        "properties": {
          "sku": {"type": "string"},
          "size": {"type": "string"},
          "color": {"type": "string"},
          "stock": {"type": ["integer", "null"], "minimum": 0, "description": "Units in stock now; 0 is out of stock and null means the store doesn't track stock (always available)"},
          "price": {"type": "number", "minimum": 0, "description": "Only when this variant costs something different from the product"}
        },
        "required": ["sku", "size", "color", "stock"],
        "additionalProperties": false
      },
      "Product": {
        "type": "object",
        "properties": {
          "code": {"type": "string"},
          "name": {"type": "string"},
          "category": {"type": "string"},
          "description": {"type": "string"},
          "price": {"type": "number", "minimum": 0},
          "currency": {"type": "string"},
          "in_stock": {"type": "boolean"},
          "variants": {"type": "array", "items": {"$ref": "#/components/schemas/Variant"}}
        },
        "required": ["code", "name", "price", "currency", "in_stock", "variants"],
        "additionalProperties": false
      },
      "CheckoutRequest": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "object",
              "properties": {
                "sku": {"type": "string", "description": "SKU of the variant, from buscar_productos"},
                "quantity": {"type": "integer", "minimum": 1, "maximum": 10}
              },
              "required": ["sku", "quantity"],
              "additionalProperties": false
            }
          }
        },
        "required": ["items"],
        "additionalProperties": false
      },
      "Checkout": {
        "type": "object",
        "properties": {
          "url": {"type": "string", "description": "The store's checkout link for the customer"},
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sku": {"type": "string"},
                "name": {"type": "string"},
                "size": {"type": "string"},
                "color": {"type": "string"},
                "quantity": {"type": "integer", "minimum": 1},
                "unit_price": {"type": "number", "minimum": 0}
              },
              "required": ["sku", "name", "quantity", "unit_price"]
            }
          },
          "total": {"type": "number", "minimum": 0},
          "currency": {"type": "string"}
        },
        "required": ["url", "items", "total", "currency"],
        "additionalProperties": false
      },
      "ProductList": {
        "type": "object",
        "properties": {"products": {"type": "array", "items": {"$ref": "#/components/schemas/Product"}}},
        "required": ["products"],
        "additionalProperties": false
      },
      "Item": {
        "type": "object",
        "properties": {
          "sku": {"type": "string"},
          "name": {"type": "string"},
          "size": {"type": "string"},
          "color": {"type": "string"},
          "quantity": {"type": "integer", "minimum": 1},
          "unit_price": {"type": "number", "minimum": 0}
        },
        "required": ["sku", "name", "size", "color", "quantity", "unit_price"],
        "additionalProperties": false
      },
      "Delay": {
        "type": "object",
        "properties": {
          "reason": {"type": "string"},
          "new_estimated_delivery": {"type": "string", "format": "date"}
        },
        "required": ["reason", "new_estimated_delivery"],
        "additionalProperties": false
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "customer_phone": {"type": "string"},
          "customer_name": {"type": "string"},
          "payment_method": {"type": "string", "description": "How the order was paid, as the customer sees it"},
          "status": {"type": "string", "enum": ["paid", "shipped", "delivered", "cancelled"]},
          "items": {"type": "array", "items": {"$ref": "#/components/schemas/Item"}},
          "total": {"type": "number", "minimum": 0},
          "currency": {"type": "string", "const": "USD"},
          "shipping_address": {"type": "string"},
          "created_at": {"type": "string", "format": "date-time"},
          "shipped_at": {"type": ["string", "null"], "format": "date-time"},
          "delivered_at": {"type": ["string", "null"], "format": "date-time"},
          "estimated_delivery": {"type": ["string", "null"], "format": "date"},
          "carrier": {"type": ["string", "null"]},
          "tracking_number": {"type": ["string", "null"]},
          "delay": {"oneOf": [{"$ref": "#/components/schemas/Delay"}, {"type": "null"}]}
        },
        "required": [
          "id", "customer_phone", "customer_name", "payment_method", "status", "items", "total", "currency",
          "shipping_address", "created_at", "shipped_at", "delivered_at", "estimated_delivery",
          "carrier", "tracking_number", "delay"
        ],
        "additionalProperties": false
      },
      "Customer": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "email": {"type": "string"},
          "phone": {"type": "string"}
        },
        "required": ["id", "name", "email", "phone"],
        "additionalProperties": false
      },
      "CustomerList": {
        "type": "object",
        "properties": {"customers": {"type": "array", "items": {"$ref": "#/components/schemas/Customer"}}},
        "required": ["customers"],
        "additionalProperties": false
      },
      "OrderList": {
        "type": "object",
        "properties": {"orders": {"type": "array", "items": {"$ref": "#/components/schemas/Order"}}},
        "required": ["orders"],
        "additionalProperties": false
      },
      "AddressChange": {
        "type": "object",
        "properties": {"address": {"type": "string", "minLength": 5}},
        "required": ["address"],
        "additionalProperties": false
      },
      "RefundRequest": {
        "type": "object",
        "properties": {"amount": {"type": "number", "exclusiveMinimum": 0, "description": "Amount in USD"}},
        "required": ["amount"],
        "additionalProperties": false
      },
      "Refund": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "order_id": {"type": "string"},
          "amount": {"type": "number"},
          "currency": {"type": "string", "const": "USD"},
          "status": {"type": "string", "enum": ["requested"]},
          "payment_method": {"type": "string", "description": "Where the refund goes: the order's original payment method"},
          "expected_within": {"type": "string", "description": "How long it takes to show up"},
          "created_at": {"type": "string", "format": "date-time"}
        },
        "required": ["id", "order_id", "amount", "currency", "status", "payment_method", "expected_within", "created_at"],
        "additionalProperties": false
      },
      "ExchangeRequest": {
        "type": "object",
        "properties": {
          "item_sku": {"type": "string", "description": "SKU of the item to exchange, from the order's items"},
          "new_size": {"type": "string", "description": "New size, for example L or 32. Omit to keep the size"},
          "new_color": {"type": "string", "description": "New color. Omit to keep the color"},
          "new_product": {"type": "string", "description": "Name of another product from the catalog, for example Alpine Down Vest. Omit to keep the product"}
        },
        "required": ["item_sku"],
        "additionalProperties": false
      },
      "ExchangeItem": {
        "type": "object",
        "properties": {
          "sku": {"type": "string"},
          "name": {"type": "string"},
          "size": {"type": "string"},
          "color": {"type": "string"},
          "unit_price": {"type": "number", "minimum": 0}
        },
        "required": ["name", "size", "color"],
        "additionalProperties": false
      },
      "Exchange": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "order_id": {"type": "string"},
          "status": {"type": "string", "enum": ["requested"]},
          "from_item": {"$ref": "#/components/schemas/ExchangeItem"},
          "to_item": {"$ref": "#/components/schemas/ExchangeItem"},
          "price_difference": {"type": "number", "description": "Positive: the customer pays the difference; negative: it's refunded"},
          "currency": {"type": "string", "const": "USD"},
          "return_label": {"type": "string", "enum": ["emailed"]},
          "new_item_ships": {"type": "string"},
          "created_at": {"type": "string", "format": "date-time"}
        },
        "required": [
          "id", "order_id", "status", "from_item", "to_item", "price_difference", "currency",
          "return_label", "new_item_ships", "created_at"
        ],
        "additionalProperties": false
      },
      "CouponRequest": {
        "type": "object",
        "properties": {"percent": {"type": "integer", "minimum": 1, "maximum": 100, "description": "Percentage off the next order"}},
        "required": ["percent"],
        "additionalProperties": false
      },
      "Courtesy": {
        "type": "object",
        "properties": {
          "code": {"type": "string"},
          "kind": {"type": "string", "enum": ["coupon", "free_express_shipping"]},
          "order_id": {"type": "string"},
          "percent": {"type": "integer"},
          "applies_to": {"type": "string", "enum": ["next_order"]},
          "valid_days": {"type": "integer"},
          "expires_on": {"type": "string", "format": "date"}
        },
        "required": ["code", "kind", "order_id", "applies_to", "valid_days", "expires_on"],
        "additionalProperties": false
      }
    }
  }
}
